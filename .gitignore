# Copyrighted game data (the XBLA package + everything unpacked out of it) — not
# distributable. `assets/package/` holds the STFS container as delivered;
# `assets/game/` is what tools/extract_stfs.py produced from it.
/assets/
/private/
*.xex
*.xexp

# Regeneratable recompiler output (run XenonRecomp on config/CaseWest.toml)
/ppc/

# Build artifacts (any build/ dir)
build/
build-asan/

# Locally built analysis binaries (rebuild with the matching tools/build_*.sh)
/tools/xex_image_dump
/tools/big_decompress
tools/__pycache__/

# Xenia ground-truth captures (huge, game-derived, local reference only) — but DO
# track the run index, which is documentation and contains no game data.
# Note the `/*` form: a trailing-slash ignore stops git descending, so the negation
# below would never be evaluated.
/Xenia logs/*
!/Xenia logs/Xenia_Run_Content.md

# Claude Code session scratch
.claude/

# Generated SPIR-V shader cache (game-derived; already covered by /assets/ above,
# named here so it is not a mystery). Rebuild it from captured microcode — see the
# Commands section of CLAUDE.md.
runtime/build-o3/
assets/game_kbm/

# Release packaging outputs and locally built bundled deps (see the same block in
# the Case Zero repo): `dist/` is the packaged tree; `thirdparty/{sdl2,ffmpeg-lgpl}`
# are rebuilt with tools/build_sdl2.sh / tools/build_ffmpeg_lgpl.sh; the extra
# runtime/build-* trees are the release and matched-identity configures.
/dist/
/thirdparty/sdl2/
/thirdparty/ffmpeg-lgpl/
build-release/
build-relid/

# The runtime log tee and --diag report (Case Zero part 105, imported part 11) land beside
# the data root, which for a dev tree is the repo root.
/cw_runtime.log
/cw_runtime.log.1
/cw_diag.txt
/cw_diag.txt.1

# The old-base (Ubuntu 22.04 / glibc 2.35) release build, built inside a podman
# container by tools/release_build_oldbase.sh: its build trees and the SDL2/ffmpeg/
# XenonUtils it compiles there are all regeneratable from source.
/runtime/build-release-oldbase/
/runtime/build-relmatch-oldbase/
/runtime/*.configure.log
/thirdparty/oldbase/
